PORT=3000
FRONTEND_URL=http://localhost:4200
NODE_ENV=development

# Base de datos (docker compose up -d levanta este Postgres)
DB_HOST=localhost
DB_PORT=5434
DB_USER=redayuda_user
DB_PASSWORD=redayuda_secret
DB_NAME=redayuda_db
# El esquema se crea solo con migraciones; ponlo en false para correrlas aparte en despliegue
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# Chequeo periódico de acopios: cada seis horas revisa qué puntos nuevos aparecieron y
# qué les hace falta a los que ya estaban. La expresión lleva segundos al principio y la
# hora es la de Colombia, no la del contenedor (Railway corre en UTC).
DIGEST_ENABLED=true
DIGEST_CRON=0 0 0,6,12,18 * * *
DIGEST_TIMEZONE=America/Bogota
# Ventana que se revisa la primera vez; después arranca donde terminó la última corrida buena.
DIGEST_WINDOW_HOURS=6
# Horas que puede llevar abierta una alerta crítica antes de reportarla como estancada.
DIGEST_CRITICAL_AGE_HOURS=24
# Horas sin alertas, comidas ni cambios tras las cuales un punto se reporta como mudo.
DIGEST_STALE_HOURS=48
DIGEST_RETENTION_DAYS=90
# Llave del disparo manual (POST /api/monitoring/digest/run, cabecera x-digest-token).
# Vacía deja el endpoint cerrado; el chequeo automático sigue funcionando igual.
DIGEST_TRIGGER_TOKEN=

# Motor de rutas de los camiones de ayuda (OSRM). El servidor público es de demostración:
# para producción, levanta uno propio y cámbialo aquí. Con ROUTING_ENABLED=false el viaje
# sigue funcionando, pero lo que falta se mide en línea recta.
ROUTING_URL=https://router.project-osrm.org
ROUTING_ENABLED=true
